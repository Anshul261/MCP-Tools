# Brave Search API (Optional - for web search)
BRAVE_API_KEY=your_brave_api_key_here

# Azure OpenAI Configuration (Chat model only)
OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=your_chat_deployment_name

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=rag_database
DB_PORT=5432

# Optional: Full database URL (overrides individual DB settings)
DB_URL=postgresql://user:password@host:port/database

# Vector database table name
PGVECTOR_TABLE=rag_documents