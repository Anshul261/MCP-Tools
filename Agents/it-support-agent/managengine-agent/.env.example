"""
Environment Configuration for ManageEngine AgentOS Integration
Copy this file to .env and update with your actual values
"""

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/manageengine_db

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ManageEngine API Configuration
MANAGEENGINE_BASE_URL=https://your-domain.manageengine.com/api/v3
MANAGEENGINE_API_KEY=your_manageengine_technician_key_here

# AgentOS Configuration
AGENTOS_SECURITY_KEY=your_agentos_security_key_here
AGENTOS_BASE_URL=http://localhost:7777

# Application Configuration
DEBUG=True
LOG_LEVEL=INFO

# Optional: Session Configuration
SESSION_TIMEOUT_SECONDS=86400  # 24 hours
MAX_CONCURRENT_SESSIONS=100

# Optional: Agent Configuration
DEFAULT_MODEL_TEMPERATURE=0.2
DEFAULT_MODEL=gpt-4o-mini
MAX_TOKENS=4000

# Optional: Performance Configuration
ENABLE_CACHING=True
CACHE_TTL_SECONDS=3600  # 1 hour
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=1

# Optional: Security Configuration
ENABLE_RATE_LIMITING=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60
ENABLE_REQUEST_VALIDATION=True

# Optional: Monitoring Configuration
ENABLE_METRICS=True
ENABLE_TRACING=False
METRICS_PORT=9090